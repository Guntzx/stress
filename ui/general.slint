// general.slint — Tab 5: Opciones Generales
// Configuración de red, reportes y versión

import {
    Tema, AppCard, AppInput, AppButton
} from "components.slint";

export component TabGeneral inherits Rectangle {
    // ── Reportes ─────────────────────────────────────────────────────
    in-out property <string> dir-reportes:    "./reports";
    in-out property <string> prefijo-reporte: "report";

    // ── Información de la app ────────────────────────────────────────
    in property <string> version: "0.0.0";

    // ── Actualización ────────────────────────────────────────────────
    in-out property <bool>   update-disponible: false;
    in property    <string>  update-version:    "";
    in-out property <string> update-estado:     "";

    // ── Callbacks hacia Rust ─────────────────────────────────────────
    callback guardar-general();
    callback seleccionar-dir-reportes();
    callback buscar-actualizacion();
    callback actualizar-app();
    callback desinstalar-app();

    background: Tema.fondo-principal;

    VerticalLayout {
        padding:  14px;
        spacing:  10px;

        // ── Fila superior: Reportes ──────────────────────────────────
        HorizontalLayout {
            spacing: 10px;

            // ── Card — Configuración de Reportes ─────────────────────
            AppCard {
                titulo:           "REPORTES";
                horizontal-stretch: 1;
                height:           190px;

                VerticalLayout {
                    spacing: 8px;

                    // Directorio de reportes con browse
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        AppInput {
                            etiqueta:           "DIR. POR DEFECTO";
                            valor <=>           root.dir-reportes;
                            horizontal-stretch: 1;
                        }
                        AppButton {
                            texto:    "[…]";
                            primario: false;
                            width:    48px;
                            height:   34px;
                            pulsado() => { root.seleccionar-dir-reportes(); }
                        }
                    }

                    AppInput {
                        etiqueta: "PREFIJO DE NOMBRE";
                        valor <=> root.prefijo-reporte;
                    }

                    Text {
                        text:        "// los archivos Excel se guardan como:\n// {prefijo}_{nombre}_{timestamp}.xlsx";
                        color:       Tema.comentario;
                        font-family: "Courier New";
                        font-size:   11px;
                        wrap:        word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }

        // ── Fila inferior: Información | Actualizaciones ─────────────
        HorizontalLayout {
            spacing: 10px;

            // ── Card Información de versión ──────────────────────────
            AppCard {
                titulo:           "INFORMACIÓN";
                horizontal-stretch: 1;
                height:           90px;

                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 20px;

                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "versión";  color: Tema.etiqueta; font-family: "Courier New"; font-size: 11px; }
                            Text { text: root.version; color: Tema.primario; font-family: "Courier New"; font-size: 14px; font-weight: 700; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "motor UI";  color: Tema.etiqueta; font-family: "Courier New"; font-size: 11px; }
                            Text { text: "Slint 1.x"; color: Tema.primario; font-family: "Courier New"; font-size: 14px; font-weight: 700; }
                        }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            // ── Card Actualizaciones ─────────────────────────────────
            upd-card := AppCard {
                titulo:           "ACTUALIZACIONES";
                horizontal-stretch: 1;
                height:           90px;

                // Deshabilitar botones mientras hay una operación en curso
                property <bool> ocupado: root.update-estado != "" &&
                    root.update-estado != "Al dia. Ya tienes la ultima version." &&
                    root.update-estado != "Actualizado. Reinicia la app.";

                VerticalLayout {
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        AppButton {
                            texto:      "BUSCAR";
                            primario:   false;
                            habilitado: !upd-card.ocupado;
                            width:      90px;
                            pulsado() => { root.buscar-actualizacion(); }
                        }

                        if root.update-disponible: AppButton {
                            texto:      "ACTUALIZAR A v" + root.update-version;
                            primario:   true;
                            habilitado: !upd-card.ocupado;
                            pulsado()  => { root.actualizar-app(); }
                        }
                    }

                    Text {
                        text: root.update-estado != ""
                            ? root.update-estado
                            : (root.update-disponible
                                ? "▲ v" + root.update-version + " disponible"
                                : "// ejecuta 'buscar' para comprobar");
                        color:       root.update-disponible && root.update-estado == ""
                            ? #ef9f27
                            : Tema.comentario;
                        font-family: "Courier New";
                        font-size:   11px;
                        wrap:        word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            // ── Card Sistema ─────────────────────────────────────────
            sist-card := AppCard {
                titulo: "SISTEMA";
                width:  180px;
                height: 90px;

                // Estado de confirmación de desinstalación (2 pasos)
                property <bool> confirmando: false;

                VerticalLayout {
                    spacing: 8px;

                    AppButton {
                        texto:    sist-card.confirmando ? "CONFIRMAR" : "DESINSTALAR";
                        primario: sist-card.confirmando;
                        pulsado() => {
                            if (sist-card.confirmando) {
                                root.desinstalar-app();
                                sist-card.confirmando = false;
                            } else {
                                sist-card.confirmando = true;
                            }
                        }
                    }

                    if sist-card.confirmando: AppButton {
                        texto:    "CANCELAR";
                        primario: false;
                        pulsado() => { sist-card.confirmando = false; }
                    }

                    if !sist-card.confirmando: Text {
                        text:        "// elimina el binario\n// del sistema";
                        color:       Tema.comentario;
                        font-family: "Courier New";
                        font-size:   11px;
                        wrap:        word-wrap;
                    }
                }
            }
        }

        // Espaciador
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
