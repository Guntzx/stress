// individual.slint — Tab 1: Prueba Individual
// Pantalla para configurar y ejecutar una prueba HTTP individual

import {
    Tema, AppCard, AppInput, AppButton,
    AppCheckbox, AppBadge, AppSelect, HeaderRowData
} from "components.slint";

export component TabIndividual inherits Rectangle {
    // ── Configuraciones guardadas ────────────────────────────────────
    in-out property <[string]> configs-lista:        [];
    in-out property <int>      config-idx:           -1;

    // ── Parámetros generales ─────────────────────────────────────────
    in-out property <string>   url-base:             "http://localhost:8080";
    in-out property <string>   iteraciones:          "10";
    in-out property <string>   peticiones-simultaneas: "1";
    in-out property <string>   timeout-seg:          "30";
    in-out property <string>   dir-salida:           "./results";
    in-out property <bool>     auto-excel:           true;
    in-out property <bool>     auto-subir:           false;
    in-out property <string>   carpeta-remota:       "";

    // ── Petición actual ──────────────────────────────────────────────
    in-out property <int>      metodo-idx:           0;
    in-out property <string>   endpoint:             "/";
    in-out property <string>   descripcion:          "";
    in-out property <string>           headers-json:  "{}";
    in-out property <string>           body-json:     "{}";
    in-out property <[HeaderRowData]>  headers-filas: [];
    in-out property <int>              headers-modo:  0; // 0=Key-Value  1=JSON

    // ── Callbacks hacia Rust ─────────────────────────────────────────
    callback cargar-config(int);
    callback seleccionar-dir-salida();
    callback abrir-dir-salida();
    callback seleccionar-dir-remota();
    callback header-agregar();
    callback header-eliminar(int);
    callback header-toggle-enabled(int);
    callback header-set-key(int, string);
    callback header-set-value(int, string);

    // Método HTTP actual como texto (para el badge de color)
    property <string> metodo-texto:
        root.metodo-idx == 0 ? "GET"    :
        root.metodo-idx == 1 ? "POST"   :
        root.metodo-idx == 2 ? "PUT"    :
        root.metodo-idx == 3 ? "DELETE" : "PATCH";

    background: Tema.fondo-principal;

    VerticalLayout {
        padding:  14px;
        spacing:  10px;

        // ── Card ancha: Preset guardado ──────────────────────────────
        AppCard {
            titulo:  "CONFIG GUARDADA";

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                AppSelect {
                    etiqueta:      "Cargar preset guardado";
                    opciones:      root.configs-lista;
                    indice-actual <=> root.config-idx;
                    horizontal-stretch: 1;
                    seleccionado(idx, _val) => { root.cargar-config(idx); }
                }

                // Decoración textual informativa
                Text {
                    text:               "// selecciona un preset para rellenar\n// todos los campos automáticamente";
                    color:              Tema.comentario;
                    font-family:        "Courier New";
                    font-size:          11px;
                    font-weight:        700;
                    vertical-alignment: center;
                }
            }
        }

        // ── 2 columnas: General | Petición ───────────────────────────
        HorizontalLayout {
            spacing:         10px;
            vertical-stretch: 1;

            // ── Columna izquierda — General ──────────────────────────
            AppCard {
                titulo:           "GENERAL";
                horizontal-stretch: 1;
                vertical-stretch:  1;

                VerticalLayout {
                    spacing: 8px;

                    AppInput {
                        etiqueta: "URL BASE";
                        valor <=> root.url-base;
                    }

                    // Fila: iteraciones / simultáneas / timeout
                    HorizontalLayout {
                        spacing: 6px;

                        AppInput {
                            etiqueta:           "ITERACIONES";
                            valor <=>           root.iteraciones;
                            horizontal-stretch: 1;
                        }
                        AppInput {
                            etiqueta:           "SIMULTÁNEAS";
                            valor <=>           root.peticiones-simultaneas;
                            horizontal-stretch: 1;
                        }
                        AppInput {
                            etiqueta:           "TIMEOUT (s)";
                            valor <=>           root.timeout-seg;
                            horizontal-stretch: 1;
                        }
                    }

                    // Directorio de salida + botón browse
                    HorizontalLayout {
                        spacing:   6px;
                        alignment: end;

                        AppInput {
                            etiqueta:           "DIR. SALIDA";
                            valor <=>           root.dir-salida;
                            horizontal-stretch: 1;
                        }
                        AppButton {
                            texto:    "[…]";
                            primario: false;
                            width:    48px;
                            height:   34px;
                            pulsado() => { root.seleccionar-dir-salida(); }
                        }
                        AppButton {
                            texto:    "[↗]";
                            primario: false;
                            width:    48px;
                            height:   34px;
                            pulsado() => { root.abrir-dir-salida(); }
                        }
                    }

                    AppCheckbox {
                        texto:    "Generar Excel automáticamente";
                        marcado <=> root.auto-excel;
                    }

                    AppCheckbox {
                        texto:    "Subir a carpeta remota";
                        marcado <=> root.auto-subir;
                    }

                    // Carpeta remota + botón browse (deshabilitados si checkbox off)
                    HorizontalLayout {
                        spacing:   6px;
                        alignment: end;

                        AppInput {
                            etiqueta:           "CARPETA REMOTA";
                            valor <=>           root.carpeta-remota;
                            habilitado:         root.auto-subir;
                            horizontal-stretch: 1;
                        }
                        AppButton {
                            texto:    "[…]";
                            primario: false;
                            habilitado: root.auto-subir;
                            width:    48px;
                            height:   34px;
                            pulsado() => { root.seleccionar-dir-remota(); }
                        }
                    }

                    // Relleno para empujar contenido hacia arriba
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            // ── Columna derecha — Petición ───────────────────────────
            AppCard {
                titulo:           "PETICIÓN";
                horizontal-stretch: 1;
                vertical-stretch:  1;

                VerticalLayout {
                    spacing: 8px;

                    AppInput {
                        etiqueta: "NOMBRE / DESCRIPCIÓN DE LA PRUEBA";
                        valor <=> root.descripcion;
                    }

                    // Método HTTP + badge de color
                    HorizontalLayout {
                        spacing:   8px;
                        alignment: start;

                        AppSelect {
                            etiqueta:      "MÉTODO HTTP";
                            opciones:      ["GET", "POST", "PUT", "DELETE", "PATCH"];
                            indice-actual <=> root.metodo-idx;
                            width:         140px;
                        }

                        AppBadge {
                            metodo: root.metodo-texto;
                            y:      28px;   // alineado con la parte baja del select
                        }
                    }

                    AppInput {
                        etiqueta: "ENDPOINT";
                        valor <=> root.endpoint;
                    }

                    // ── Selector de modo de headers ──────────────
                    VerticalLayout {
                        spacing: 5px;

                        // Etiqueta + tabs de modo
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text:        "HEADERS";
                                color:       Tema.etiqueta;
                                font-family: "Courier New";
                                font-size:   11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            // Tab KEY-VALUE (por defecto)
                            Rectangle {
                                width:         86px;
                                height:        20px;
                                background:    root.headers-modo == 0 ? #1a0f00 : transparent;
                                border-color:  root.headers-modo == 0 ? Tema.primario : Tema.borde;
                                border-width:  1px;
                                border-radius: 2px;

                                Text {
                                    text:                 "KEY-VALUE";
                                    color:                root.headers-modo == 0 ? Tema.primario : Tema.comentario;
                                    font-family:          "Courier New";
                                    font-size:            11px;
                                    font-weight:          700;
                                    horizontal-alignment: center;
                                    vertical-alignment:   center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.headers-modo = 0; }
                                }
                            }

                            // Tab JSON
                            Rectangle {
                                width:         46px;
                                height:        20px;
                                background:    root.headers-modo == 1 ? #1a0f00 : transparent;
                                border-color:  root.headers-modo == 1 ? Tema.primario : Tema.borde;
                                border-width:  1px;
                                border-radius: 2px;

                                Text {
                                    text:                 "JSON";
                                    color:                root.headers-modo == 1 ? Tema.primario : Tema.comentario;
                                    font-family:          "Courier New";
                                    font-size:            11px;
                                    font-weight:          700;
                                    horizontal-alignment: center;
                                    vertical-alignment:   center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.headers-modo = 1; }
                                }
                            }
                        }

                        // ── Modo KEY-VALUE ────────────────────────────
                        if root.headers-modo == 0: VerticalLayout {
                            spacing: 3px;

                            // Cabecera de columnas
                            HorizontalLayout {
                                spacing: 4px;
                                padding-left:  24px;
                                padding-right: 30px;

                                Text {
                                    text:               "KEY";
                                    color:              Tema.comentario;
                                    font-family:        "Courier New";
                                    font-size:          10px;
                                    font-weight:        700;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text:               "VALUE";
                                    color:              Tema.comentario;
                                    font-family:        "Courier New";
                                    font-size:          10px;
                                    font-weight:        700;
                                    horizontal-stretch: 1;
                                }
                            }

                            // Filas editables
                            for item[idx] in root.headers-filas: HorizontalLayout {
                                spacing: 4px;
                                height:  28px;

                                // Checkbox enabled
                                chk := Rectangle {
                                    width:         18px;
                                    height:        18px;
                                    y:             (parent.height - self.height) / 2;
                                    background:    Tema.fondo-principal;
                                    border-color:  item.enabled ? Tema.primario : Tema.borde;
                                    border-width:  1px;
                                    border-radius: 2px;

                                    if item.enabled: Text {
                                        text:                 "x";
                                        color:                Tema.primario;
                                        font-family:          "Courier New";
                                        font-size:            11px;
                                        font-weight:          700;
                                        horizontal-alignment: center;
                                        vertical-alignment:   center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.header-toggle-enabled(idx); }
                                    }
                                }

                                // Key
                                key-rect := Rectangle {
                                    horizontal-stretch: 1;
                                    height:             24px;
                                    y:                  (parent.height - self.height) / 2;
                                    background:         Tema.fondo-principal;
                                    border-color:       key-ti.has-focus ? Tema.borde-focus : Tema.borde;
                                    border-width:       1px;
                                    border-radius:      2px;
                                    opacity:            item.enabled ? 1.0 : 0.4;

                                    key-ti := TextInput {
                                        x:                  5px;
                                        width:              parent.width - 10px;
                                        height:             parent.height;
                                        text:               item.key;
                                        color:              Tema.primario;
                                        font-family:        "Courier New";
                                        font-size:          12px;
                                        vertical-alignment: center;
                                        single-line:        true;
                                        enabled:            item.enabled;
                                        edited() => { root.header-set-key(idx, key-ti.text); }
                                    }
                                }

                                // Value
                                val-rect := Rectangle {
                                    horizontal-stretch: 1;
                                    height:             24px;
                                    y:                  (parent.height - self.height) / 2;
                                    background:         Tema.fondo-principal;
                                    border-color:       val-ti.has-focus ? Tema.borde-focus : Tema.borde;
                                    border-width:       1px;
                                    border-radius:      2px;
                                    opacity:            item.enabled ? 1.0 : 0.4;

                                    val-ti := TextInput {
                                        x:                  5px;
                                        width:              parent.width - 10px;
                                        height:             parent.height;
                                        text:               item.value;
                                        color:              Tema.primario;
                                        font-family:        "Courier New";
                                        font-size:          12px;
                                        vertical-alignment: center;
                                        single-line:        true;
                                        enabled:            item.enabled;
                                        edited() => { root.header-set-value(idx, val-ti.text); }
                                    }
                                }

                                // Botón eliminar fila
                                Rectangle {
                                    width:         22px;
                                    height:        22px;
                                    y:             (parent.height - self.height) / 2;
                                    background:    transparent;
                                    border-color:  del-ta.has-hover ? Tema.primario : Tema.borde;
                                    border-width:  1px;
                                    border-radius: 2px;

                                    Text {
                                        text:                 "×";
                                        color:                #aaaaaa;
                                        font-family:          "Courier New";
                                        font-size:            13px;
                                        horizontal-alignment: center;
                                        vertical-alignment:   center;
                                    }
                                    del-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.header-eliminar(idx); }
                                    }
                                }
                            }

                            // Botón añadir header
                            AppButton {
                                texto:    "+ HEADER";
                                primario: false;
                                width:    90px;
                                height:   24px;
                                pulsado() => { root.header-agregar(); }
                            }
                        }

                        // ── Modo JSON ─────────────────────────────────
                        if root.headers-modo == 1: AppInput {
                            valor <=>   root.headers-json;
                            multilinea: true;
                        }
                    }

                    AppInput {
                        etiqueta:   "BODY (JSON)";
                        valor <=>   root.body-json;
                        multilinea: true;
                        // Deshabilitado si el método es GET (índice 0)
                        habilitado: root.metodo-idx != 0;
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }
    }
}
